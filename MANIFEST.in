include LICENSE README.md CHANGELOG.md MODEL_SPEC.md VALIDATION.md RISK_ANALYTICS.md
recursive-include docs *.md
recursive-include tests *.py
recursive-include configs *.json
recursive-include examples *.py
recursive-include tools *.py
prune old
prune .venv
prune .venv-rc030
prune .pytest_tmp
prune .pytest_cache
prune dist
prune build
global-exclude *.ipynb *.pyc *.pyo .coverage
